{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "surface-dots-installer",
  "identifier": "dev.snesdots.installer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "surface-dots - installer",
        "width": 740,
        "height": 700,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "visible": true,
        "alwaysOnTop": true,
        "fullscreen": false,
        "maximized": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
