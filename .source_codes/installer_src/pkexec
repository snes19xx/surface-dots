#!/usr/bin/env bash
# Fake pkexec for sandbox testing. Redirects the SDDM step's /usr and /etc writes
# into /tmp/sandbox-root so the real system is never touched. Never prompts.
SANDBOX_ROOT="/tmp/sandbox-root"

mkdir -p "$SANDBOX_ROOT/usr/share/sddm/themes"
mkdir -p "$SANDBOX_ROOT/etc/sddm.conf.d"

if [[ "$1" == "bash" && "$2" == "-c" ]]; then
    PATCHED_SCRIPT=$(echo "$3" | sed "s|/usr/|$SANDBOX_ROOT/usr/|g; s|/etc/|$SANDBOX_ROOT/etc/|g")
    echo "[fake-pkexec] running: $PATCHED_SCRIPT" >&2
    bash -c "$PATCHED_SCRIPT"
    exit $?
fi

echo "[fake-pkexec] unhandled args: $*" >&2
exit 1
