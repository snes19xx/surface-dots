{
  "security.workspace.trust.untrustedFiles": "newWindow",
  "security.workspace.trust.startupPrompt": "always",
  "liveServer.settings.donotShowInfoMsg": true,
  "git.openRepositoryInParentFolders": "never",
  "window.autoDetectColorScheme": true,
  "workbench.preferredLightColorTheme": "Everforest Pro Light Vibrant",
  "security.workspace.trust.banner": "never",
  "files.autoSave": "afterDelay",
  "editor.stickyScroll.scrollWithEditor": false,
  "workbench.tree.enableStickyScroll": false,
  "terminal.integrated.stickyScroll.enabled": false,
  "rainbow_csv.enable_sticky_header": false,
  "window.newWindowProfile": "Default",
  "workbench.activityBar.location": "top",
  "editor.stickyScroll.enabled": false,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
  },
  "editor.fontFamily": "'JetBrains Mono', 'Droid Sans Mono', 'monospace', 'Font Awesome 7 Brands', 'Font Awesome 7 Free'",
  "explorer.confirmDragAndDrop": false,
  "chat.viewTitle.enabled": false,
  "chat.viewSessions.enabled": false,
  "chat.tools.todos.showWidget": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "github.copilot.chat.enabled": false,
  "github.copilot.chat.showPanel": false,
  "qt-core.additionalQtPaths": [
    {
      "name": "Qt-5.15.18-linux-g++_from_PATH",
      "path": "/usr/bin/qmake",
    },
  ],
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "python.defaultInterpreterPath": "/sbin/python3.14",
  "python.venvPath": "/home/snes",
  "jupyter.askForKernelRestart": false,
  "workbench.preferredDarkColorTheme": "Everforest Pro Dark Vibrant",
  "workbench.editorAssociations": {
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
    "*.qrc": "qt-core.qrcEditor",
  },
  "editor.colorDecorators": true,
  "workbench.iconTheme": "al",
}
