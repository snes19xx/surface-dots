[general]
status_path = "~/.config/vdirsyncer/status/"

[pair google_sync]
a = "google_cloud"
b = "local_dir"
collections = ["emailemailemail@gmail.com"]
conflict_resolution = "a wins"
metadata = ["color"]

[storage google_cloud]
type = "google_calendar"
token_file = "~/.config/vdirsyncer/google_token"
client_id = ""
client_secret = ""

[storage local_dir]
type = "filesystem"
path = "~/.local/share/vdirsyncer/calendars/"
fileext = ".ics"
